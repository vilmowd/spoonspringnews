# Spoonspring reads this file on startup. Leave DATABASE_URL empty to use the
# built-in Postgres that starts with the site (port 5433).

PORT=3000
DATABASE_URL=
PG_PORT=5433

# Clock. Etc/GMT-3 means UTC+3 all year.
# For daylight saving, use a region name such as Europe/Bucharest.
# MORNING_HOUR is when the daily section run starts. The other two hours
# are the magazine slots an agent can still fill by hand.
SCHED_TZ=Etc/GMT-3
MORNING_HOUR=8
MIDDAY_HOUR=12
EVENING_HOUR=18

# Free writing APIs. Create a key, leave the rest of the site as it is.
#   Gemini (free tier in Google AI Studio):
#     TEXT_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
#     TEXT_MODEL=gemini-2.0-flash
#   Groq (free tier):
#     TEXT_API_BASE=https://api.groq.com/openai/v1
#     TEXT_MODEL=llama-3.3-70b-versatile
# Paid options use the same two fields:
#   OpenAI TEXT_API_BASE=https://api.openai.com/v1 TEXT_MODEL=gpt-4o-mini
TEXT_API_KEY=
TEXT_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
TEXT_MODEL=gemini-2.0-flash

# Local dashboard. It stays on this machine and talks to the magazine.
DASHBOARD_PORT=4000
MAGAZINE_URL=http://127.0.0.1:3000

# Optional. When this is empty, the model still chooses the cover
# (palette, motif, and label) and Spoonspring draws it.
IMAGE_API_KEY=
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=dall-e-3

# Desk password. Change this before anyone else can reach the site.
DESK_TOKEN=folio-desk

# Secret for the publish API. The site writes one into .env on first start
# if this is empty. Send it as: Authorization: Bearer <key>
# GET /api/titles lists the titles. GET /api/editions lists today's three magazine slots.
# POST /api/articles fills one. GET, PATCH, PUT, and DELETE /api/articles manage stories.
# POST /api/articles/bulk-delete removes many. Add "publication": "wire" for a sister title.
# Use a long random value before the site is on the public internet.
PUBLISH_KEY=

# Public address used in canonical links, share links, the sitemap, and RSS.
# Example: https://spoonspring.com
SITE_URL=

# Shown on the privacy, terms, and accessibility pages.
CONTACT_EMAIL=

# Set to 1 when a reverse proxy sets X-Forwarded-For and X-Forwarded-Proto.
TRUST_PROXY=

# Optional token from Google Search Console.
GOOGLE_SITE_VERIFICATION=

# Revenue. All optional. The site starts inserting them on its own
# once the values are present. You can also set these from the Desk.
AMAZON_TAG=
ADSENSE_CLIENT=
ADSENSE_SLOT=
ADSENSE_CPM_CENTS=0
TIP_URL=
TIP_LABEL=Support this desk
